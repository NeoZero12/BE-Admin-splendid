{
  "name": "backend-admin",
  "version": "1.0.0",
  "description": "TypeScript API for the Splendid Admin panel",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
